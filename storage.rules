rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Blog images - public read, authenticated upload for admins & editors
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // Sector leadership photos - public read, authenticated upload for staff
    match /sectors/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // Executive leadership photos - public read, admin-only write & delete
    match /leaders/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageFile();
      allow delete: if isAdmin();
    }

    // User profile images - public read, owner write
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageFile();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
