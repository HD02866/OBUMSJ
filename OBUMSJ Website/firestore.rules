rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuthenticated() && userDocExists() && (getUserData().get('role', '') in roles);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isLeadership() {
      return hasRole(['admin', 'main_amir']);
    }

    function isStaff() {
      return hasRole(['admin', 'main_amir', 'amir']);
    }

    function isBlogEditor() {
      return hasRole(['admin', 'main_amir', 'blog_manager']);
    }

    // Helper: Check if user has explicit granular permission for a sector
    function hasSectorPermission(sectorSlug, requiredPerm) {
      return isAuthenticated() && (
        isLeadership() ||
        (
          userDocExists() &&
          getUserData().get('role', '') in ['amir', 'vice_amir', 'writer', 'sector_member'] &&
          sectorSlug in getUserData().get('sectorAccess', {}) &&
          requiredPerm in getUserData().get('sectorAccess', {}).get(sectorSlug, {}).get('permissions', [])
        )
      );
    }

    // ============================================
    // USERNAMES INDEX (for secure 1-to-1 username lookup)
    // ============================================
    match /usernames/{username} {
      // Allow exact single document lookup (for login via username & pre-registration availability check)
      allow get: if true;
      // Disallow collection queries/listing to prevent user enumeration
      allow list: if false;
      // Allow authenticated user to claim a username mapping to their own UID
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Only administrators can update or delete mappings
      allow update, delete: if isAdmin();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // 1. Single profile lookup (getDoc):
      // An authenticated user can ALWAYS read their own profile without any document lookups.
      // Leadership & staff can view member profiles for management.
      allow get: if isAuthenticated() && (request.auth.uid == userId || isStaff());

      // 2. Collection listing (onSnapshot / getDocs on collection):
      // Only leadership & staff can list users; regular users cannot query the collection.
      allow list: if isStaff();

      // 3. Profile Creation:
      // An authenticated user can create their own profile with role: 'pending' and status: 'pending'.
      // Leadership can create user accounts directly.
      allow create: if isAuthenticated() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'pending' &&
          request.resource.data.status == 'pending'
        ) || isLeadership()
      );

      // 4. Profile Update:
      // Users can update their own personal info (cannot change role, status, approval metadata, or permission overrides).
      // Leadership can update all fields (including role promotion & approval), but cannot modify their own permissions unless admin.
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'status',
            'approvedAt',
            'approvedBy',
            'customPermissions',
            'deniedPermissions',
            'sectorAccess'
          ])
        ) || (
          isLeadership() && (request.auth.uid != userId || isAdmin())
        )
      );

      // 5. Permanent Profile Deletion:
      // Only Chief Administrators can delete a user profile record.
      allow delete: if isAdmin();
    }

    // ============================================
    // BLOGS COLLECTION
    // ============================================
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isBlogEditor();
    }

    // ============================================
    // ANNOUNCEMENTS COLLECTION
    // ============================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ============================================
    // QIRAT PROGRAMS COLLECTION
    // ============================================
    match /qirat_programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ============================================
    // SECTORS COLLECTION (Content & Leadership)
    // ============================================
    match /sectors/{sectorId} {
      // Public visitors and members can view active/published sectors; staff & leadership can view all
      allow read: if resource.data.get('isActive', true) == true || isStaff();

      // Sector document creation & deletion strictly restricted to Admin & Main Amir
      allow create, delete: if isLeadership();

      // Sector updates:
      // - Admin and Main Amir have full mutation rights across all 10 sectors
      // - Sector Amir, Vice Amir, and Writer must be explicitly granted permissions for this sector
      // - Leadership appointments & replacements (leadership field) are STRICTLY restricted to Admin & Main Amir
      // - Active/archive status (isActive field) requires 'sectors.content.publish'
      // - Content and translation edits require 'sectors.content.edit' or 'sectors.translations.edit'
      allow update: if isAuthenticated() && (
        isLeadership() ||
        (
          (
            hasSectorPermission(sectorId, 'sectors.content.edit') ||
            hasSectorPermission(sectorId, 'sectors.translations.edit')
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leadership']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']) ||
            hasSectorPermission(sectorId, 'sectors.content.publish')
          )
        )
      );
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUid in [request.auth.uid, 'all'] ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.targetUid == 'all' ||
        (userDocExists() && resource.data.targetRole == getUserData().get('role', '')) ||
        isAdmin()
      );
      allow create: if isStaff();
      allow update, delete: if isAuthenticated() && (resource.data.targetUid == request.auth.uid || isAdmin());
    }

    // ============================================
    // AUDIT LOGS COLLECTION (Immutable Audit Trail)
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isLeadership();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================
    // SETTINGS COLLECTION
    // ============================================
    match /settings/{settingId} {
      // Public visitors can read intended public website content & general contact settings
      // Authenticated members can only read role permission templates required for client UI operation
      // Private administrative settings and configuration remain strictly restricted to Administrators
      allow read: if settingId in ['general', 'homepage', 'about'] ||
                     (settingId == 'permissions' && isAuthenticated()) ||
                     isAdmin();
      // Only verified administrators can create, update, or delete settings
      allow write: if isAdmin();
    }

    // ============================================
    // LEADERS COLLECTION (Executive Leadership CMS)
    // ============================================
    match /leaders/{leaderId} {
      // Public visitors and members can view only published leadership profiles
      // Administrators can view all profiles including drafts
      allow read: if (resource.data.published == true) || isAdmin();
      // Only authorized administrators can create, update, or delete profiles
      allow write: if isAdmin();
    }

    // ============================================
    // SECTOR RESOURCES COLLECTION (Educational Resources CMS)
    // ============================================
    match /sector_resources/{resourceId} {
      // Public visitors and members can view only explicitly published educational resources
      // Administrators can view all resources including drafts
      allow read: if (resource.data.published == true) || isAdmin();

      // Common schema validation for sector educational resource documents
      function isValidSectorResource(data) {
        return data.keys().hasAll([
            'sector', 'type', 'title', 'description', 'fileId', 'fileName',
            'mimeType', 'fileSize', 'order', 'status', 'published',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          data.keys().hasOnly([
            'sector', 'type', 'title', 'description', 'fileId', 'fileName',
            'mimeType', 'fileSize', 'folderId', 'order', 'status', 'published',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          data.sector in ['qirat', 'ruqiya', 'academy'] &&
          data.type in ['audio', 'document', 'book', 'video', 'other'] &&
          data.title is map &&
          data.title.keys().hasOnly(['en', 'am', 'om', 'ar']) &&
          (!('en' in data.title) || (data.title.en is string && data.title.en.size() <= 300)) &&
          (!('am' in data.title) || (data.title.am is string && data.title.am.size() <= 300)) &&
          (!('om' in data.title) || (data.title.om is string && data.title.om.size() <= 300)) &&
          (!('ar' in data.title) || (data.title.ar is string && data.title.ar.size() <= 300)) &&
          data.description is map &&
          data.description.keys().hasOnly(['en', 'am', 'om', 'ar']) &&
          (!('en' in data.description) || (data.description.en is string && data.description.en.size() <= 3000)) &&
          (!('am' in data.description) || (data.description.am is string && data.description.am.size() <= 3000)) &&
          (!('om' in data.description) || (data.description.om is string && data.description.om.size() <= 3000)) &&
          (!('ar' in data.description) || (data.description.ar is string && data.description.ar.size() <= 3000)) &&
          data.fileId is string && data.fileId.size() > 0 && data.fileId.size() <= 200 &&
          data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 300 &&
          data.mimeType is string && data.mimeType.size() > 0 && data.mimeType.size() <= 150 &&
          (data.fileSize is int || data.fileSize is float) && data.fileSize >= 0 &&
          (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 200)) &&
          data.order is int &&
          data.published is bool &&
          (
            (data.published == true && data.status == 'published') ||
            (data.published == false && data.status == 'draft')
          ) &&
          data.createdAt is timestamp &&
          data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 100 &&
          data.updatedAt is timestamp &&
          data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 100;
      }

      // Only authorized administrators can create new resources with valid schema
      allow create: if isAdmin() &&
        isValidSectorResource(request.resource.data);

      // Only authorized administrators can update resources; createdAt and createdBy cannot be altered
      allow update: if isAdmin() &&
        isValidSectorResource(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy;

      // Only authorized administrators can delete resources
      allow delete: if isAdmin();
    }

    // ============================================
    // SECTOR RESOURCE PERMISSIONS (Admin-Only Drive Permission Tracking)
    // ============================================
    match /sector_resource_permissions/{resourceId} {
      // Only authorized administrators can read, create, update, or delete permission tracking metadata
      allow read, write: if isAdmin();
    }

    // ============================================
    // CONTACT MESSAGES (Public Inquiries)
    // ============================================
    match /contact_messages/{messageId} {
      // Anyone (including public visitors) can submit an inquiry with strict field validation
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
                       request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'read', 'createdAt']) &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200 &&
                       request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 150 &&
                       request.resource.data.subject is string && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 300 &&
                       request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000 &&
                       request.resource.data.status == 'unread' &&
                       request.resource.data.read == false;

      // Strictly restrict viewing, updating, and deleting to verified Administrators
      allow read, update, delete: if isAdmin();
    }

    // Default catch-all denies anything unlisted
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
