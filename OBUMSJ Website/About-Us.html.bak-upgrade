    <header>
        <h1 class="typewriter-title" data-i18n="about_page.hero_title" data-typewriter-phrases='["About Our Community", "Faith, Unity & Knowledge", "Serving Muslim Students"]'>About Our Community</h1>
        <p data-i18n="about_page.hero_subtitle">We are a Muslim student community dedicated to spiritual growth, academic excellence, and social responsibility. Our mission is to build ethical leaders who serve society with knowledge, faith, and integrity.</p>
    </header>

    <div class="container">
        <!-- About Section -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.who_title">Who We Are</h2>
            <p data-i18n="about_page.who_text">Our community is a student-based Islamic union that provides religious guidance, academic support, and social activities for Muslim students. We aim to create a strong brotherhood and sisterhood environment where members grow spiritually, intellectually, and socially.</p>
        </div>

        <!-- Vision & Mission -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="sectors.title">Vision & Mission</h2>
            <div class="vm-grid">
                <div class="vm-box">
                    <h3 data-i18n="about_page.vision_title">Our Vision</h3>
                    <p data-i18n="about_page.vision_text">To be a leading Muslim student community that nurtures faith, knowledge, and leadership, producing responsible individuals who positively impact society.</p>
                </div>
                <div class="vm-box">
                    <h3 data-i18n="about_page.mission_title">Our Mission</h3>
                    <p data-i18n="about_page.mission_text">To provide Islamic education, academic support, social services, and leadership training through organized programs and departments.</p>
                </div>
            </div>
        </div>

        <!-- Leadership Section -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.leadership_title">Executive Leadership</h2>
            <div class="leaders">
                <div class="leader-card">
                    <img src="./IMAGE/We are visted.jpg" alt="President">
                    <h4>Abdellah Ahmed</h4>
                    <p data-i18n="about_page.leadership_president">Community Amir (President)</p>
                </div>
                <div class="leader-card">
                    <img src="./IMAGE/Best 4.jpg" alt="Vice President">
                    <h4>Mohammed Yusuf</h4>
                    <p data-i18n="about_page.leadership_vice">Vice Amir</p>
                </div>
                <div class="leader-card">
                    <img src="./IMAGE/Best 7.jpg" alt="Secretary">
                    <h4>Hassan Ali</h4>
                    <p data-i18n="about_page.leadership_secretary">General Secretary</p>
                </div>
            </div>
        </div>

        <!-- Departments -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.departments_title">Our Departments</h2>
            <div class="dept-grid">
                <div class="dept-item" data-i18n="about_page.department_qirat">Qirat Sector</div>
                <div class="dept-item" data-i18n="about_page.department_ruqiyah">Ruqiyah Sector</div>
                <div class="dept-item" data-i18n="about_page.department_charity">Charity Sector</div>
                <div class="dept-item" data-i18n="about_page.department_finance">Finance Sector</div>
                <div class="dept-item" data-i18n="about_page.department_dawr">Dawr Al-Hasan Sector</div>
                <div class="dept-item" data-i18n="about_page.department_information">Information & Media Sector</div>
                <div class="dept-item" data-i18n="about_page.department_ziyara">Ziyara & Outreach Sector</div>
                <div class="dept-item" data-i18n="about_page.department_academy">Academy & Education Sector</div>
                <div class="dept-item" data-i18n="about_page.department_social">Social Affairs Sector</div>
            </div>
        </div>

        <!-- Community Stats - UPDATED WITH COUNTING ANIMATION -->
        <div class="section-card animate-on-scroll" id="community-stats">
            <h2 class="section-title" data-i18n="about_page.stats_title">Community Impact</h2>
            <div class="stats">
                <div class="stat-box">
                    <h2 class="counter" data-target="300" data-speed="50">0</h2>
                    <p data-i18n="about_page.stats_members">Active Members</p>
                </div>
                <div class="stat-box">
                    <h2 class="counter no-plus" data-target="9" data-speed="100">0</h2>
                    <p data-i18n="about_page.stats_departments">Departments</p>
                </div>
                <div class="stat-box">
                    <h2 class="counter" data-target="120" data-speed="50">0</h2>
                    <p data-i18n="about_page.stats_events">Events Organized</p>
                </div>
                <div class="stat-box">
                    <h2 class="counter" data-target="10" data-speed="100">0</h2>
                    <p data-i18n="about_page.stats_years">Years of Service</p>
                </div>
            </div>
        </div>

        <!-- History Timeline -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.history_title">Our History</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <span>2015</span>
                    <p data-i18n="about_page.history_2015">Community founded by Muslim students to strengthen faith and unity.</p>
                </div>
                <div class="timeline-item">
                    <span>2018</span>
                    <p data-i18n="about_page.history_2018">Established 5 official departments and launched weekly programs.</p>
                </div>
                <div class="timeline-item">
                    <span>2022</span>
                    <p data-i18n="about_page.history_2022">Expanded to 9 sectors and started charity and outreach projects.</p>
                </div>
                <div class="timeline-item">
                    <span>2026</span>
                    <p data-i18n="about_page.history_2026">Launched official website and digital management system.</p>
                </div>
            </div>
        </div>

        <!-- Gallery -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.gallery_title">Gallery of Activities</h2>
            <div class="gallery-grid">
                <img src="./IMAGE/Best 2.jpg" alt="Activity 1">
                <img src="./IMAGE/Best 6.jpg" alt="Activity 2">
                <img src="./IMAGE/Best 10.jpg" alt="Activity 3">
                <img src="./IMAGE/Best 9.jpg" alt="Activity 4">
            </div>
        </div>

        <!-- Constitution -->
        <div class="section-card animate-on-scroll">
            <h2 class="section-title" data-i18n="about_page.constitution_title">Community Constitution</h2>
            <p data-i18n="about_page.constitution_text">You can download our official constitution and bylaws document.</p>
            <a href="docs/constitution.pdf" download class="download-btn" data-i18n="about_page.constitution_download">Download Constitution PDF</a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3 data-i18n="footer.about">About OBUMSJ</h3>
                    <p data-i18n="footer.about_text">ODA BULTUM UNIVERSITY MUSLIM STUDENTS' JAMA'A is dedicated to supporting Muslim students in their academic and spiritual journey.</p>
                    <div class="footer-social">
