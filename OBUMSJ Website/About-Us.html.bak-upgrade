                        <a href="https://tiktok.com/@obumsj" target="_blank" title="TikTok"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="footer-column">
                    <h3 data-i18n="footer.quick">Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="./index.html" data-i18n="nav.home">Home</a></li>
                        <li><a href="./About-Us.html" data-i18n="nav.about">About Us</a></li>
                        <li><a href="./sector.html" data-i18n="nav.sectors">Sectors</a></li>
                        <li><a href="./Blog.html" data-i18n="nav.blog">Blog</a></li>
                        <li><a href="./contact.html" data-i18n="nav.contact">Contact Us</a></li>
