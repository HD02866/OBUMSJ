<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="about_page.page_title">About Us | OBUMSJ - Oda Bultum University Muslim Students' JAMA'A</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
<script src="js/theme-engine.js"></script>
    <style>
        /* Add your existing About page styles here */
        :root{
          --primary:#2f8f3d;
          --secondary:#0f3d2e;
          --gold:#d4af37;
          --bg:#f4f9f5;
          --text:#1f2937;
        }

        *{margin:0;padding:0;box-sizing:border-box;font-family:Poppins,Arial,sans-serif;}
        body{background:var(--bg);color:var(--text);line-height:1.6;}

        .pattern{
          background-color:var(--bg);
          background-image:
            radial-gradient(circle at 20% 20%, rgba(47,143,61,0.07) 1px, transparent 1px),
            radial-gradient(circle at 80% 80%, rgba(47,143,61,0.07) 1px, transparent 1px);
          background-size:40px 40px;
        }

        header{
          background:linear-gradient(135deg,var(--secondary),var(--primary));
          color:#fff;
          padding:90px 20px;
          text-align:center;
          margin-top: 80px;
        }
        header h1{font-size:44px;font-weight:700;}
        header p{max-width:900px;margin:15px auto;font-size:18px;}

        .container{width:90%;max-width:1100px;margin:50px auto;}

        .section-card{
          background:rgba(255,255,255,0.65);
          backdrop-filter:blur(12px);
          -webkit-backdrop-filter:blur(12px);
          border-radius:18px;
          padding:35px;
          margin-bottom:40px;
          border-left:6px solid var(--primary);
          box-shadow:0 10px 30px rgba(0,0,0,0.08);
        }

        .section-title{
          font-size:28px;
          margin-bottom:15px;
          color:var(--secondary);
        }

        .vm-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px;}
        .vm-box{
          background:#fff;
          padding:25px;
          border-radius:16px;
          box-shadow:0 8px 20px rgba(0,0,0,0.08);
          transition:0.3s;
        }
        .vm-box:hover{transform:translateY(-8px);box-shadow:0 15px 40px rgba(0,0,0,0.15);}
        .vm-box h3{color:var(--primary);margin-bottom:10px;}

        .leaders{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;}
        .leader-card{
          background:#fff;
          padding:20px;
          border-radius:16px;
          text-align:center;
          box-shadow:0 8px 20px rgba(0,0,0,0.08);
          transition:0.3s;
        }
        .leader-card:hover{transform:translateY(-8px);box-shadow:0 18px 40px rgba(0,0,0,0.15);}
        .leader-card img{
          width:130px;height:130px;border-radius:50%;object-fit:cover;
          border:4px solid var(--primary);margin-bottom:10px;
        }
        .leader-card h4{font-size:20px;color:var(--secondary);}
        .leader-card p{color:var(--primary);font-weight:600;}

        .dept-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
        .dept-item{
          background:#fff;
          padding:18px;
          border-radius:14px;
          border-left:5px solid var(--primary);
          box-shadow:0 6px 18px rgba(0,0,0,0.07);
          transition:0.3s;
        }
        .dept-item:hover{transform:translateY(-6px);}

        .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;}
        .stat-box{
          background:#fff;
          padding:25px;
          border-radius:16px;
          box-shadow:0 8px 20px rgba(0,0,0,0.08);
        }
        .stat-box h2{font-size:32px;color:var(--primary);}
        .stat-box p{font-weight:600;}

        footer{
          background:var(--secondary);
          color:#fff;
          padding:40px 20px;
          text-align:center;
          margin-top:60px;
        }

        .animate-on-scroll{opacity:0;transform:translateY(60px);transition:0.8s;}
        .animate-on-scroll.show{opacity:1;transform:translateY(0);}

        @media(max-width:900px){
          .vm-grid,.leaders,.dept-grid,.stats{grid-template-columns:1fr;}
        }
        .download-btn{display:inline-block;background:var(--primary);color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:bold;margin-top:10px;}
        .download-btn:hover{background:var(--secondary);}

        .timeline{border-left:4px solid var(--primary);padding-left:25px;}
        .timeline-item{margin-bottom:25px;position:relative;}
        .timeline-item::before{content:"";width:14px;height:14px;background:var(--primary);border-radius:50%;position:absolute;left:-9px;top:5px;}
        .timeline-item span{font-weight:bold;color:var(--secondary);}

        .org-chart{text-align:center;}
        .org-row{display:flex;justify-content:center;gap:20px;margin-top:20px;flex-wrap:wrap;}
        .org-box{background:#fff;padding:15px 25px;border-radius:12px;border-left:5px solid var(--primary);box-shadow:0 6px 18px rgba(0,0,0,.08);}

        .gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;}
        .gallery-grid img{width:100%;border-radius:12px;transition:.3s;box-shadow:0 6px 18px rgba(0,0,0,.08);}
        .gallery-grid img:hover{transform:scale(1.05);}
        @media(max-width:900px){.gallery-grid{grid-template-columns:repeat(2,1fr);} }

        /* Counting animation styles */
        .counter {
            font-size: 32px;
            color: var(--primary);
            font-weight: bold;
        }
        .counter::after {
            content: '+';
        }
        .no-plus::after {
            content: '';
        }
    </style>
</head>
<body class="pattern">
