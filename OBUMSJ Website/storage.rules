rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Blog images - public read, authenticated upload for admins & editors
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // Sector leadership photos - public read, authenticated upload for staff
    match /sectors/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // User profile images - public read, owner write
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageFile();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
