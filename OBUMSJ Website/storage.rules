rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    function userDocExists() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userDocExists() && getUserData().role == 'admin';
    }

    function isLeadership() {
      return userDocExists() && (getUserData().role in ['admin', 'main_amir']);
    }

    function isStorageSectorAuthorized(sectorSlug, requiredPerm) {
      return userDocExists() && (
        (getUserData().role in ['admin', 'main_amir']) ||
        (
          getUserData().role in ['amir', 'vice_amir', 'writer', 'sector_member'] &&
          sectorSlug in getUserData().get('sectorAccess', {}) &&
          requiredPerm in getUserData().get('sectorAccess', {}).get(sectorSlug, {}).get('permissions', [])
        )
      );
    }

    // Blog images - public read, authenticated upload for admins & editors
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // Sector media uploads (leadership portraits and banners) - public read; scoped upload/delete for authorized leaders
    match /sectors/{sectorSlug}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImageFile() && isStorageSectorAuthorized(sectorSlug, 'sectors.media.upload');
      allow delete: if isAuthenticated() && isStorageSectorAuthorized(sectorSlug, 'sectors.media.upload');
    }

    // Executive leadership photos - public read, leadership write & delete
    match /leaders/{allPaths=**} {
      allow read: if true;
      allow create, update: if isLeadership() && isImageFile();
      allow delete: if isLeadership();
    }

    // User profile images - public read, owner write
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageFile();
    }

    // Default catch-all denies anything unlisted
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
